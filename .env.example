

# --- GitHub App ---
# Se obtienen al registrar la GitHub App en: https://github.com/settings/apps
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# --- Base de datos ---
POSTGRES_USER=archguardian
POSTGRES_PASSWORD=archguardian_pass
POSTGRES_DB=archguardian
DATABASE_URL=postgresql://archguardian:archguardian_pass@postgres:5432/archguardian

# --- Cola de mensajes ---
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672

# --- Caché ---
REDIS_URL=redis://redis:6379

# --- IA — elige uno: "ollama" o "azure" ---
LLM_PROVIDER=ollama

# Ollama (local, privado, gratuito)
OLLAMA_BASE_URL=http://ollama:11434

# Azure OpenAI (empresarial)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=